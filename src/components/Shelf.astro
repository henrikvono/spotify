---
const { title } = Astro.props;
---

<section class="shelf">
  <a href="#">{title}</a>
  <div class="shelf-content">
    <slot />
  </div>
</section>

<style>
  .shelf {
    margin: 20px;
  }
  .shelf-content {
    display: flex;
    gap: 20px;
    overflow-x: auto;
  }

  a {
    text-decoration: none;
    color: white;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 16px;
  }

  a:hover {
    text-decoration: underline;
  }
</style>
