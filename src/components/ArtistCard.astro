---
const { imgPath, title } = Astro.props;
---

<div class="artist-card">
  <img src={imgPath} alt={title} />
  <a href="#">{title}</a>
  <p class="artist">Kunstner</p>
</div>

<style>
  .artist-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    text-align: center;
    color: white;
    padding-bottom: 30px;
    min-width: 150px;
  }

  div a {
    text-decoration: none;
    color: white;
    text-align: left !important;
    margin-top: 10px;
  }

  div a:hover {
    text-decoration: underline;
    cursor: pointer;
  }

  .artist-card:hover {
    background-color: #1f1f1f;
    border-radius: 5px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  p {
    text-align: left;
    color: #8e8e8e;
    font-size: 0.9rem;
  }

  p.artist {
    color: rgb(156, 156, 156);
    margin-top: 8px !important;
  }

  .artist-card img {
    width: 150px;
    border-radius: 150px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5);
  }
</style>
