---
const { imgPath, title, body } = Astro.props;
---

<div class="playlist-card">
  <img src={imgPath} alt={title} />
  <a href="#" class="albumtitle">{title}</a>
  <p class="artist">{body}</p>
</div>

<style>
  .playlist-card {
    display: flex;
    flex-direction: column;
    padding: 1rem;
    border-radius: 10px;
    text-align: center;
    padding-bottom: 30px;
    max-width: 100%;
  }
  .playlist-card img {
    width: 150px;
    border-radius: 8px;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5);
  }

  div.playlist-card {
    min-width: 150px;
  }

  div a {
    text-decoration: none;
    color: white;
    text-align: left !important;
    margin-top: 10px;
  }

  div a:hover {
    text-decoration: underline;
    cursor: pointer;
  }

  .playlist-card:hover {
    background-color: #1f1f1f;
    border-radius: 5px;
    cursor: pointer;
    box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.5);
  }

  p {
    text-align: left;
    color: #8e8e8e;
    font-size: 0.9rem;
  }

  p.artist {
    color: rgb(156, 156, 156);
    margin-top: 8px !important;
  }
</style>
